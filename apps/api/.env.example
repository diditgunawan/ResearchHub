# ResearchHub (ResearchForge) Environment Configuration Example
# ============================================================

# Environment: local, test, staging, production
APP_ENV=local

# Database & Queue Connections
# For local SQLite development:
DATABASE_URL=sqlite+aiosqlite:///./researchforge.db
# For local PostgreSQL with pgvector (via docker-compose):
# DATABASE_URL=postgresql+asyncpg://rf:rf_dev_only@localhost:5432/researchforge

REDIS_URL=redis://localhost:6379/0

# Security Secrets (Must be at least 32 characters in production)
SESSION_SECRET=rf-dev-secret-key-at-least-32-bytes-long-for-testing!

# Access Model & Authentication (ADR-009 & Blueprint 17)
ACCESS_MODE=single_owner
REGISTRATION_POLICY=closed
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ResearchHub

# Open Scholarly API Keys & Mailto (Polite Pool & Metered Tiers)
OPENALEX_MAILTO=researchforge@example.org
OPENALEX_API_KEY=
CROSSREF_MAILTO=researchforge@example.org
NCBI_API_KEY=
UNPAYWALL_EMAIL=researchforge@example.org

# Option 1: Live LLM Provider & Synthesis Settings
# Choose one of: gemini | ollama | None (rule-engine fallback)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here

# Recommended Current Generation Models
LLM_MODEL_SYNTHESIS=gemini-3.8-flash
LLM_MODEL_VERIFY=gemini-3.1-pro-preview
LLM_EMBEDDING_MODEL=gemini-embedding-001

# Local Ollama Settings (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Quota & Budgets
QUOTA_WEEKLY_CREDITS_FREE=50
GLOBAL_MONTHLY_LLM_BUDGET_USD=100.0
